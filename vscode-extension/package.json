{
   "name": "abap-cleaner",
   "displayName": "ABAP cleaner",
   "description": "ABAP cleaner applies 100+ cleanup rules to ABAP code at a single keystroke.",
   "version": "1.29.0",
   "publisher": "SAPOSS",
   "engines": {
      "vscode": "^1.109.0"
   },
   "license": "Apache-2.0",
   "categories": [
      "Formatters"
   ],
   "keywords": [
      "ABAP cleaner",
      "ABAP",
      "Clean Code",
      "Clean ABAP",
      "ABAP Formatter",
      "Pretty Printer",
      "formatter",
      "automated cleanup",
      "interactive cleanup",
      "code cleanup",
      "code formatting",
      "code refactoring",
      "code modernization",
      "code optimization",
      "code quality",
      "code readability",
      "code maintainability",
      "CDS Views",
      "Data Definition Language",
      "DDL"
   ],
   "preview": false,
   "main": "./out/extension.js",
   "contributes": {
      "commands": [
         {
            "command": "abapCleaner.formatDocument",
            "title": "ABAP Cleaner: Format Document",
            "category": "ABAP"
         },
         {
            "command": "abapCleaner.formatSelection",
            "title": "ABAP Cleaner: Format Selection",
            "category": "ABAP"
         },
         {
            "command": "abapCleaner.formatInteractively",
            "title": "ABAP Cleaner: Format Interactively",
            "category": "ABAP"
         },
         {
            "command": "abapCleaner.readOnlyPreview",
            "title": "ABAP Cleaner: Show Read-Only Preview",
            "category": "ABAP"
         }
      ],
      "keybindings": [
         {
            "command": "editor.action.formatDocument",
            "key": "ctrl+5",
            "mac": "cmd+5",
            "when": "editorTextFocus && (resourceExtname == .abap || resourceExtname == .acds || resourceExtname == .asddls)"
         },
         {
            "command": "editor.action.formatSelection",
            "key": "ctrl+4",
            "mac": "cmd+4",
            "when": "editorTextFocus && (resourceExtname == .abap || resourceExtname == .acds || resourceExtname == .asddls)"
         },
         {
            "command": "abapCleaner.formatInteractively",
            "key": "ctrl+shift+4",
            "mac": "cmd+shift+4",
            "when": "editorTextFocus && (resourceExtname == .abap || resourceExtname == .acds || resourceExtname == .asddls)"
         },
         {
            "command": "abapCleaner.readOnlyPreview",
            "key": "ctrl+shift+5",
            "mac": "cmd+shift+5",
            "when": "editorTextFocus && (resourceExtname == .abap || resourceExtname == .acds || resourceExtname == .asddls)"
         }
      ],
      "configuration": {
         "title": "ABAP Cleaner",
         "properties": {
            "abapCleaner.debugMode": {
               "type": "boolean",
               "default": false,
               "description": "Enable debug logging for ABAP cleaner"
            }
         }
      },
      "languageModelTools": [
         {
            "name": "abapCleaner_formatDocument",
            "displayName": "Format ABAP Document",
            "modelDescription": "Applies ABAP cleaner's automated cleanup rules to ABAP (.abap) or CDS view DDL (.acds/.asddls) files, formatting each file in place. Provide the absolute path(s) of the file(s) to format via the 'filePaths' argument - this is the preferred way and avoids opening an editor for each file; you can pass many paths in one call to format them in a batch. If 'filePaths' is omitted, the currently active editor document is formatted instead. Use this when the user asks to clean up, format, or pretty-print ABAP or CDS source files.",
            "userDescription": "Format ABAP or CDS documents with ABAP cleaner",
            "toolReferenceName": "formatDocument",
            "canBeReferencedInPrompt": true,
            "icon": "$(sparkle)",
            "inputSchema": {
               "type": "object",
               "properties": {
                  "filePaths": {
                     "type": "array",
                     "items": {
                        "type": "string"
                     },
                     "description": "Absolute paths of the ABAP (.abap) or CDS view DDL (.acds/.asddls) files to format. If omitted, the active editor document is formatted."
                  }
               }
            },
            "tags": [
               "abap",
               "formatting",
               "cleanup"
            ]
         }
      ]
   },
   "activationEvents": [
      "onStartupFinished",
      "onFileSystem:abap",
      "onFileSystem:acds",
      "onLanguage:abap",
      "onLanguage:acds"
   ],
   "qna": "https://github.com/SAP/abap-cleaner/issues",
   "devDependencies": {
      "@types/node": "22.19.19",
      "@types/vscode": "1.109.0",
      "@vscode/vsce": "3.9.2",
      "typescript": "7.0.2"
   },
   "extensionKind": [
      "ui"
   ],
   "scripts": {
      "compile": "tsc -p .",
      "watch": "tsc -watch -p .",
      "lint": "tsc --noEmit -p .",
      "package": "npm run compile && vsce package"
   },
   "icon": "abap-cleaner.png",
   "pricing": "Free",
   "capabilities": {
      "virtualWorkspaces": true,
      "untrustedWorkspaces": {
         "supported": false,
         "description": "This extension launches a native Eclipse RCP executable."
      }
   },
   "bugs": {
      "url": "https://github.com/SAP/abap-cleaner/issues"
   },
   "repository": {
      "type": "git",
      "url": "https://github.com/SAP/abap-cleaner.git"
   },
   "homepage": "https://github.com/SAP/abap-cleaner"
}
